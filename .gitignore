# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
# Gradle build output (android/build is a separate tree from the root /build/)
/android/build/
/android/.gradle/

# Local configuration (SDK paths)
android/local.properties
ios/Flutter/ephemeral/
macos/Flutter/ephemeral/

# Android release signing (never commit secrets or the upload keystore)
android/key.properties
android/*.jks
android/*.keystore

# Prototype HTML UI (reference only; huge node_modules)
remote_lab_ui/node_modules/
remote_lab_ui/dist/
remote_lab_ui/dev.stderr.log
remote_lab_ui/dev.stdout.log


# Per-machine dev helpers (hard-coded local drive paths)
scripts/use_e_drive.ps1

# Local research / generated publication artifacts
/output/
/tool/arxiv_context_landmarks.py
/tool/arxiv_context_search.py

# Local Python env for running gateway tests
server/.venv/
server/dist/
server/build/

# Local scratch / screenshots
/tmp/

# Portable API/settings export (contains secrets). Copy
# config/settings.example.json → config/local-settings.json and fill keys.
/expert-chat-settings.json
/*.expert-chat-settings.json
/config/*.json
!/config/settings.example.json

# Self-hosted AuthService/Gateway runtime secrets and state
server/authservice/.env
server/authservice/.initial_admin_password
server/authservice/.gateway_admin_sub
server/authservice/secrets/
server/authservice/upstream/
server/authservice/.*-request.json
server/authservice/.*-response.json
server/authservice/UPSTREAM_COMMIT
server/**/data/
